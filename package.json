{
  "name": "cashero-backend",
  "version": "2.1.0",
  "description": "Cashero API proxy server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "test:e2e": "npm run build && playwright test --workers=1",
    "test:e2e:smoke": "npm run build && playwright test --workers=1 --project=chromium e2e/offline-flow.spec.cjs e2e/notification-flow.spec.cjs e2e/ai-cooldown.spec.cjs",
    "test": "node --test tests/api.test.mjs tests/data-features.test.mjs tests/random-quote.test.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.65.1",
    "vite": "^6.4.5"
  }
}
